# Local development defaults. Copy to .env and fill in real secrets.
SERVICE_NAME=messaging_service
PORT=8080

DATABASE_URL=postgres://messaging:messaging@localhost:5432/messaging?sslmode=disable

KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=messaging_service
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=attachments
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_USE_PATH_STYLE=true

# Proves the caller is an edge/gateway; required for /internal/* routes.
IDENTITY_ISSUER=https://identity.internal
IDENTITY_AUDIENCE=messaging
IDENTITY_PUBLIC_KEY=replace-with-base64-or-pem-key
# IDENTITY_NEXT_PUBLIC_KEY=
INTERNAL_SERVICE_TOKEN=replace-with-edge-service-token

ATTACHMENT_MAX_BYTES=10485760
UPLOAD_URL_TTL=15m
DOWNLOAD_URL_TTL=15m
GC_PENDING_AFTER=24h
GC_INTERVAL=15m
OUTBOX_RELAY_INTERVAL=500ms
SHUTDOWN_TIMEOUT=20s
PAGE_LIMIT_DEFAULT=50
PAGE_LIMIT_MAX=100
APPEAL_URL_BASE=https://support.local/appeals
